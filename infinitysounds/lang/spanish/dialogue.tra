// encoding: UTF-8

@10000 = ~Os arrancaré la cabeza de los hombros; ¡os lo juro!~ [celoga28]
@10001 = ~¡Lo divino guiará mi espada hacia vuestro corazón negro!~ [celoga29]
@10002 = ~¡Saludos y me alegro de veros, buen amigo!~ [celoga21] ~¡Saludos y me alegro de veros, buena amiga!~ [celoga21]
@10003 = ~Que los dioses os sonrían.~ [celoga22]
@10004 = ~¿Cómo estáis?~ [celoga23]
@10005 = ~¡Sois vil y oscuro!~ [celoga24] ~¡Sois vil y oscura!~ [celoga24]
@10006 = ~¡Sois demasiado para mí!~ [cor22]
@10007 = ~¡Estaré encantado de arrancaros el corazón!~ [cor18]
@10008 = ~¡Cruzad espadas conmigo y moriréis!~ [cor19]
@10009 = ~Venid y hablemos, entonces, amigo.~ [cor11] ~Venid y hablemos, entonces, amiga.~ [cor11]
@10010 = ~Como queráis.~ [cor12]
@10011 = ~Rápido, entonces.~ [cor13]
@10012 = ~¡Se me ha acabado la paciencia!~ [cor14]
@10013 = ~¡Demonio! ¡Despiadado demonio!~ [firkra29]
@10014 = ~¡Os veré colgado!~ [firkra25] ~¡Os veré colgada!~ [firkra25]
@10015 = ~Respirad mientras podáis. ¡Pagaréis por esto!~ [firkra26]
@10016 = ~Mientras seáis educado, os toleraré.~ [firkra18] ~Mientras seáis educada, os toleraré.~ [firkra18]
@10017 = ~~ [firkra19]
@10018 = ~Sabéis lo que es un baño, ¿verdad?~ [firkra20]
@10019 = ~¡Fuera de aquí, o llamaré a la guardia!~ [firkra21]
@10020 = ~¡Esto no ha terminado!~ [gaal37]
@10021 = ~¡Tengo muy poca paciencia con gente como vos!~ [gaal29]
@10022 = ~¡No voy a aguantar más esto!~ [gaal33]
@10023 = ~Parecéis lo suficientemente digno.~ [gaal26] ~Parecéis lo suficientemente digna.~ [gaal26]
@10024 = ~Tengo cosas mejores que hacer.~ [gaal27]
@10025 = ~~ [gaal28]
@10026 = ~Tened cuidado; sé lo que sois.~ [gaal34]
@10027 = ~¡Cuidado, o pronto acabaréis colgado de vuestra propia lengua!~ [bregax16]
@10028 = ~~ [bregax18]
@10029 = ~¡Buenos días!~ [bregax10]
@10030 = ~Confío en que todo vaya bien.~ [bregax11]
@10031 = ~No tengo tiempo para hablar con alguien como vos.~ [bregax12]
@10032 = ~¡No permitiré que gentuza como vos acabe conmigo!~ [isaeax20]
@10033 = ~¡Borraré vuestro asqueroso linaje de los reinos!~ [isaeax16]
@10034 = ~No merecéis más que la muerte, ni menos.~ [isaeax17]
@10035 = ~¡Sois bienvenido!~ [isaeax09] ~¡Sois bienvenida!~ [isaeax09]
@10036 = ~¿Es este un lugar adecuado para hablar?~ [isaeax10]
@10037 = ~¿Qué puede ser ahora?~ [isaeax11]
@10038 = ~¡Hablemos y acabemos con esto!~ [isaeax12]
@10039 = ~¿Queréis hablar?! ¡Lo discutiremos a base de espadas!~ [dermin08]
@10040 = ~No estoy acostumbrado a la violencia; pero en vuestro caso, ¡está justificada!~ [termin16]
@10041 = ~¡Me alegro de veros por aquí!~ [termin09]
@10042 = ~¿Tenéis alguna pregunta que queráis hacerme?~ [termin10]
@10043 = ~Necesito que me prestéis atención un momento.~ [termin11]
@10044 = ~¡No tengo tiempo para vuestras tonterías sin sentido!~ [termin12]
@10045 = ~¡Argh! ¡Esto no ha terminado!~ [lehtin20]
@10046 = ~¡Os haré polvo los huesos, necio!~ [lehtin16] ~¡Os haré polvo los huesos, necia!~ [lehtin16]
@10047 = ~¡Preparaos para enfrentaros al filo de mi espada!~ [lehtin17]
@10048 = ~Que los dioses os sonrían.~ [lehtin09]
@10049 = ~Como queráis.~ [lehtin10]
@10050 = ~Saludos y buenos negocios.~ [lehtin11]
@10051 = ~¡¿Qué pasa?!~ [lehtin12]
@10052 = ~¡Tengo que reorganizarme! ¡Aún no habéis ganado!~ [telwyn20]
@10053 = ~Vuestra miserable vida terminará aquí; ¡yo me encargaré de ello!~ [telwyn16]
@10054 = ~¡Criatura despreciable, no sobreviviréis a nuestro encuentro!~ [telwyn17]
@10055 = ~¿Qué es lo que buscas, amigo?~ [telwyn09] ~¿Qué es lo que buscas, amiga?~ [telwyn09]
@10056 = ~¿Qué queréis?~ [telwyn10]
@10057 = ~Hablad, si queréis.~ [telwyn11]
@10058 = ~¡Dad gracias por que os hable!~ [telwyn12]
@10059 = ~¡Esto no vale la pena en absoluto!~ [lathan20]
@10060 = ~Más os vale tener cuidado por aquí; no querréis que os... pase algo.~ [lathan16]
@10061 = ~No suelo ser propenso a la violencia; ¡pero tampoco suelo tratar con gente como vos!~ [lathan17]
@10062 = ~¡Me alegro de veros, amigo!~ [lathan09] ~¡Me alegro de veros, amiga!~ [lathan09]
@10063 = ~¿Qué os trae por aquí?~ [lathan10]
@10064 = ~Hablaré con vos si queréis.~ [lathan11]
@10065 = ~Simplemente no tengo tiempo para lidiar con vos. ¡Daos prisa!~ [lathan12]
@10066 = ~¡No! ¡Debo escapar!~ [busya22]
@10067 = ~¡No os vais a salir con la vuestra!~ [busya18]
@10068 = ~¡Recibiréis lo que os merecéis enseguida!~ [busya19]
@10069 = ~¡Bienvenido!~ [busya11] ~¡Bienvenida!~ [busya11]
@10070 = ~¿Puedo preguntaros qué queréis aquí?~ [busya12]
@10071 = ~Quizá podamos sacaros partido aquí.~ [busya13]
@10072 = ~¿Qué espera encontrar aquí gente como vos?~ [busya14]
@10073 = ~¡No me voy a quedar aquí para esto!~ [goldan24]
@10074 = ~¡Vos ahí, deteneos un momento!~ [goldan15]
@10075 = ~Será mejor que me dejéis en paz.~ [goldan20]
@10076 = ~¡No voy a permitir que me amenacéis!~ [goldan21]
@10077 = ~¡Hola, amigo!~ [goldan13] ~¡Hola, amiga!~ [goldan13]
@10078 = ~¿Tenéis algo que decir?~ [goldan14]
@10079 = ~¡¿Qué pasa ahora?!~ [goldan16]
@10080 = ~¡No! ¡No me mataréis aquí!~ [baronp20]
@10081 = ~¡Que alguien me ayude!~ [cefald31]
@10082 = ~¡Fuera de aquí! ¡No me toquéis!~ [delcia20]
@10083 = ~¡Hoy no tendréis mi cabeza aquí!~ [demin24]
@10084 = ~¡No voy a caer aquí!~ [demson20]
@10085 = ~¡Argh! ¡No merecéis que muera por vos, hoy no!~ [deshar25]
@10086 = ~¡Voy a buscar ayuda! ¡Y volveré!~ [elhan132]
@10087 = ~¡No!~ [ellesi36]
@10088 = ~¡Debo huir!~ [garren20]
@10089 = ~¡A las sombras! ¡Debo esconderme!~ [jariel20]
@10090 = ~¡Aaaah! ¡Corred! ¡Corred! ¡Correeed!~ [kalah26]
@10091 = ~¡Tengo... que... retroceder!~ [kaylxx20]
@10092 = ~¡Retirada!~ [kpdomo25]
@10093 = ~¡Tengo... que huir!~ [lavok31]
@10094 = ~¡Tengo que huir! ¡Dejadme en paz!~ [mariax20]
@10095 = ~¡Señor de la Tormenta, tened piedad!~ [nallab20]
@10096 = ~¡Helm, me debilito!~ [oisigx20]
@10097 = ~¡Ayudadme! ¡Ayudadme, por favor!~ [phaere23]
@10098 = ~¡No! ¡Nooo! ¡Debo irme!~ [rielev20]
@10099 = ~¡Señor de la Mañana, protegedme!~ [thaddi20]
@10100 = ~¡Volveré! ¡Recordad mis palabras!~ [trgeni25]
